# ===== Cấu hình Hệ thống Quản lý tài sản Sói Biển =====
# File .env chỉ dùng khi chạy bằng Node.js trên máy (npm run db:setup, npm start, npm run backup).
# Trên Cloudflare Workers: biến thường ở wrangler.jsonc ("vars"), biến bí mật khai báo bằng `npx wrangler secret put`.
NODE_ENV=production
PORT=8080

# Chuỗi kết nối Supabase: Dashboard → Connect → "Session pooler" (IPv4). Thay [YOUR-PASSWORD] bằng mật khẩu CSDL.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Tên miền thật – được in vào mã QR. ĐẶT ĐÚNG TRƯỚC KHI IN NHÃN.
PUBLIC_BASE_URL=https://taisan.soibien.vn
SESSION_DAYS=14

COMPANY_NAME=CÔNG TY CỔ PHẦN SÓI BIỂN TRUNG THỰC
COMPANY_SHORT=SÓI BIỂN
# Hotline bảo trì hiển thị trên nhãn QR & trang quét
MAINTENANCE_HOTLINE=

# Tài khoản quản trị đầu tiên (chỉ dùng khi CSDL còn trống – lúc chạy npm run db:setup)
ADMIN_EMAIL=admin@soibien.vn
ADMIN_PHONE=0900000000
ADMIN_PASSWORD=DoiMatKhauNay2026

# Đăng nhập Google (để trống nếu chưa dùng)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_DOMAINS=

# OTP SMS: console | webhook
SMS_PROVIDER=console
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# Cho phép xem thông tin tối thiểu khi quét QR chưa đăng nhập (true/false)
PUBLIC_SCAN=true
